    "./power": "./src/power.js",
    "./matrix": "./src/matrix.js",
    "./ttest": "./src/ttest.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "license": "MIT",
  "author": "SKYSEED TECH LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skyseed-tech/stats-core.git"
  },
  "homepage": "https://cn8t.com/",
  "bugs": {
    "url": "https://github.com/skyseed-tech/stats-core/issues"
  },
  "keywords": [
    "statistics",
